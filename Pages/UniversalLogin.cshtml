@page
@model Group_Project_Offical.Pages.UniversalLoginModel
@{

}

<!DOCTYPE html>
<head>
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1"

</head>
<body>
    <div class="centred-items">
        <h1 class="roboto-black">Welcome</h1>
        <div class="login-container">
            <div>
                <p class="login-p">Please Sign In</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div>
                    @Model.Message
                    <button type="button">x</button>
                </div>

            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div>
                    @Model.ErrorMessage
                    <button type="button">x</button>
                </div>

            }
            <form method="post" class="login-form">
                <input type="hidden" asp-for="LoginForm.ReturnUrl" />


                <div>
                    <label asp-for="LoginForm.Username" class="login-text-field">Username</label>
                    <input asp-for="LoginForm.Username" class="login-text-field" />
                    <span asp-validation-for="LoginForm.Username" class="login-text-field"></span>
                </div>

                <div>
                    <label asp-for="LoginForm.Password" class="login-text-field">Password</label>
                    <input asp-for="LoginForm.Password" class="login-text-field" />
                    <span asp-validation-for="LoginForm.Password" class="login-text-field"></span>
                </div>

                <div class="login-checkbox">
                    <input asp-for="LoginForm.RememberMe" type="checkbox"/>
                    <label asp-for="LoginForm.RememberMe">Remember Me</label>
                </div>

                <div>
                    <button type="submit" class="btn">Sign In</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
