@page
@model Group_Project_Offical.Pages.Donation_Manager_Send_DonationsModel

<h2>SEND DONATIONS</h2>

@if(!string.IsNullOrEmpty(Model.ErrorMessage))
{
	<partial>@Model.ErrorMessage</partial>
}

@if(!string.IsNullOrEmpty(Model.message))
{
	<p>@Model.message</p>
}

@if(Model.OutgoingDonations == null || Model.OutgoingDonations.Count == 0)
{
	<p>NO DONATION TO SEND</p>
}


<table>
	<thead>
		<tr>
			<th>ID</th>
			<th>DATE</th>
			<th>DONER</th>
			<th>TOTAL ITEM</th>
			<th>ESTIMATED VALUE</th>
			<th>ITEMS</th>
			<th>ACTIONS</th>
			
			
		</tr>
	</thead>
	<tbody>
		@foreach (var d in Model.OutgoingDonations)
		{
			<tr>
				<td>@d.DonationID</td>
					<td>@d.DonationDate</td>
						<td>@d.DonerName</td>
							<td>@d.TotalItems</td>
								<td>@d.EstimatedValue</td>
								<td>
									@if(d.Items == null || d.Items.Count == 0)
					{
						<span>NO ITEMS</span>
					}
					else
					{
						<ul>
							@foreach (var item in d.Items)
							{
								<li>
									<strong>@item.ItemName</strong>
									(@item.size, @item.Gender, @item.Condition)
									@if (!string.IsNullOrWhiteSpace(item.Description))
									{
										<br />
										<span>@item.Description</span>
									}
									@if (!string.IsNullOrWhiteSpace(item.PhotoURL))
									{
										<br />
										<img src="@item.PhotoURL" />

										
									}
								</li>
							}
						</ul>
					}
				</td>
				<td>
					<form method="post" asp-page-handler="Ship">
						<input type="hidden" name="donationId" value="@d.DonationID" />
						<button type="submit">SHIP ITEM</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>