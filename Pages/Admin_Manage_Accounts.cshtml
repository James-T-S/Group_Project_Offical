@page
@model Group_Project_Offical.Pages.Admin_Manage_AccountsModel
@{
    ViewData["UserType"] = "admin";
}

<div class="container my-5 px-3">
    <h1 class="mb-4" style="font-family: 'Roboto', sans-serif; font-weight: 800;">Manage Accounts</h1>


    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div>@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div>@Model.ErrorMessage</div>
    }


    <form method="get" class="mb-4 d-flex gap-2 w-100 justify-content-center">
        <label for="q">Search</label>
        <input id="q" name="Query" value="@Model.Query" class="form-control w-auto" />
        <button type="submit" class="btn">Apply</button>
        <a asp-page="/Admin_Manage_Accounts">Clear</a>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center align-middle custom-table text-nowrap">
            <thead style="background-color: #C2A68C;">
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Active</th>
                    <th>Freeze</th>
                    <th>Delete</th>
                </tr>

            </thead>
            <tbody class="table-group-divider">
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td>@u.UserRole</td>
                        <td>@(u.IsActive ? "Yes" : "No")</td>
                        <td class="justify-content-center align-items-center">
                            <form method="post" asp-page-handler="ToggleActive">
                                <div class="mb-3">
                                    <input type="hidden" name=Username value="@u.Username" class="form-control" />
                                    <input type="hidden" name="MakeActive" value="@(u.IsActive ? "false" : "true")" class="form-control" />
                                    <button type="submit" class="btn">@(u.IsActive ? "Freeze" : "Unfreeze")</button>
                                </div>
                            </form>
                        </td>

                        <td class="justify-content-center align-items-center">
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete @u.Username?');">
                                <div class="mb-3">
                                    <input type="hidden" name=Username value="@u.Username" class="form-control" />
                                    <button type="submit" class="btn btn-light">Delete</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

