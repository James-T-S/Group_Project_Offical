@page
@model Group_Project_Offical.Pages.SignUpModel
@{
}


<!doctype html>
<html lang="en">
<head>
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1"
</head>
<body>
    <div class="centred-items">
        <h1 class="roboto-black" style="margin-top: 4vh;">Welcome</h1>
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div>
                @Model.Message
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErroredMessage))
        {
            <div>
                @Model.ErroredMessage
            </div>
        }
        <div class="login-container">
            <h1 class="login-p">Sign Up</h1>
            <form method="post" asp-antiforgery="true">

                <div>
                    <label for="Username" class="login-text-field">User Name</label>
                    <input type="text" id="Username" asp-for="DonerSignUpForm.UserName" class="login-text-field" />
                    <span asp-validation-for="DonerSignUpForm.UserName" class="login-text-field"></span>
                </div>

                <div>
                    <label for="Password" class="login-text-field">Password</label>
                    <input type="password" id="Password" asp-for="DonerSignUpForm.Password" class="login-text-field" />
                    <span asp-validation-for="DonerSignUpForm.Password" class="login-text-field"></span>
                </div>

                <div>
                    <label for="FirstName" class="login-text-field">First Name</label>
                    <input type="text" id="FirstName" asp-for="DonerSignUpForm.FirstName" class="login-text-field" />
                    <span asp-validation-for="DonerSignUpForm.FirstName" class="login-text-field"></span>
                </div>

                <div>
                    <label for="LastName" class="login-text-field">Last Name</label>
                    <input type="text" id="LastName" asp-for="DonerSignUpForm.LastName" class="login-text-field" />
                    <span asp-validation-for="DonerSignUpForm.LastName" class="login-text-field"></span>
                </div>

                <div>
                    <label for="Email" class="login-text-field">Email</label>
                    <input type="text" id="Email" asp-for="DonerSignUpForm.Email" class="login-text-field" />
                    <span asp-validation-for="DonerSignUpForm.Email" class="login-text-field"></span>
                </div>

                <div>
                    <label for="PhoneNumber" class="login-text-field">Phone Number</label>
                    <input type="tel" id="PhoneNumber" asp-for="DonerSignUpForm.PhoneNumber" class="login-text-field" />
                    <span asp-validation-for="DonerSignUpForm.PhoneNumber" class="login-text-field"></span>
                </div>

                <div>
                    <label for="Address" class="login-text-field">Address</label>
                    <textarea id="Address" asp-for="DonerSignUpForm.Address" rows="2" class="login-text-field"></textarea>

                </div>

                <div style="margin-top: 5vh;">
                    <button type="submit" class="btn">Create Account</button>
                    <button type="reset" class="btn">Clear Form</button>
                </div>



            </form>
        </div>
    </div>

</body>

</html>