@page
@model Group_Project_Offical.Pages.Admin_Manage_CharityModel
@{
}

<div class="container d-flex flex-column align-items-center" style="max-width:800px; margin:0 auto;">

    <h1 class="mb-4 text-center" style="font-family: 'Roboto', sans-serif; font-weight: 800;">Manage Charities</h1>

    @if (!string.IsNullOrWhiteSpace(Model.errormessage))
    {
        <div class="alert alert-danger w-100 text-center">@Model.errormessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success w-100 text-center">@Model.Message</div>
    }


    <form method="post" class="mb-5 w-100 d-flex flex-column align-items-center" asp-page-handler="">
        <h2 class="mb-4 text-center">Create Charity</h2>

        <div class="mb-3 w-100" style="max-width:400px;">
            <label class="form-label">Charity Name</label>
            <input name="charity.CharityName" value="@Model.charity.CharityName" class="form-control text-center" />
        </div>

        <div class="mb-3 w-100" style="max-width:400px;">
            <label class="form-label">Description</label>
            <textarea name="charity.Description" class="form-control text-center" rows="4">@Model.charity.Description</textarea>
        </div>

        <div class="mb-3 w-100" style="max-width:400px;">
            <label class="form-label">Email</label>
            <input name="charity.Email" value="@Model.charity.Email" class="form-control text-center" />
        </div>

        <div class="mb-3 w-100" style="max-width:400px;">
            <label class="form-label">Phone Number</label>
            <input name="charity.PhoneNum" value="@Model.charity.PhoneNum" class="form-control text-center" />
        </div>

        <div class="mb-3 w-100" style="max-width:400px;">
            <label class="form-label">Address</label>
            <input name="charity.Address" value="@Model.charity.Address" class="form-control text-center" />
        </div>

        <div class="mb-3 w-100" style="max-width:400px;">
            <label class="form-label">Registration</label>
            <input name="charity.RegistrationNum" value="@Model.charity.RegistrationNum" class="form-control text-center" />
        </div>

        <div class="form-check mb-3 w-100" style="max-width:400px;">
            <input type="checkbox" name="charity.Isactive" class="form-check-input" id="IsActiveCheck" @(Model.charity.IsActive ? "checked" : "") />
            <label class="form-check-label fs-5" for="IsActiveCheck">Active</label>
        </div>

        <button type="submit" class="btn btn-success px-5 text-center" style="display:flex; justify-content:center; align-items:center;">Create</button>
    </form>

    <hr class="w-100" />

    <form method="get" class="mb-4 d-flex gap-2 w-100 justify-content-center">
        <input type="text" name="query" value="@Model.query" placeholder="please enter to search" class="form-control w-auto" />
        <button type="submit" class="btn btn-primary text-center">Search</button>
    </form>

    <h2 class="mb-3 text-center">Charities</h2>

    @if (Model.c == null || Model.c.Count == 0)
    {
        <p class="text-center">No charities Found</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead style="background-color: #C2A68C;">
                    <tr>
                        <th>ID</th>
                        <th>NAME</th>
                        <th>EMAIL</th>
                        <th>PHONE</th>
                        <th>REG</th>
                        <th>REGISTERED</th>
                        <th>ACTIVE</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    @foreach (var x in Model.c)
                    {
                        <tr class="bg-light align-middle">
                            <td>@x.CharityID</td>
                            <td>@x.CharityName</td>
                            <td>@x.Email</td>
                            <td>@x.PhoneNum</td>
                            <td>@x.RegistrationNum</td>
                            <td>@x.DateRegistered</td>
                            <td>@(x.IsActive ? "Yes" : "No")</td>
                            <td>
                                <form method="post" asp-page-handler="ToggleActive" class="d-inline w-auto">
                                    <input type="hidden" name="charityID" value="@x.CharityID" />
                                    <input type="hidden" name="makeActive" value="@(!x.IsActive)" />
                                    <button type="submit" class="btn btn-sm text-center" style="background-color: #374f40; color: white; border: none; display:flex; justify-content:center; align-items:center;">
                                        @(x.IsActive ? "Freeze" : "Activate")
                                    </button>
                                </form>

                                <form method="post" asp-page-handler="ToggleDelete" class="d-inline w-auto" onsubmit="return confirm('Delete this charity?');">
                                    <input type="hidden" name="charityID" value="@x.CharityID" />
                                    <button type="submit" class="btn btn-sm text-center" style="background-color: #374f40; color: white; border: none; display:flex; justify-content:center; align-items:center;">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
