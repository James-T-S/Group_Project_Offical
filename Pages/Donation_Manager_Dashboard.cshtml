@page
@model Group_Project_Offical.Pages.Donation_Manager_DashboardModel
@{
}


<h2>Donation Manager Dashboard</h2>

<ul>
    <li>
        <a asp-page="/Donation_Manager_Incoming_Donations">
            View incoming donations
        </a>
    </li>
</ul>


<ul>
    <li>
        <a asp-page="/Donation_Manager_Send_Donations">
           Send donations
        </a>
    </li>
</ul>

  <h1>Total Sustainability Metrics</h1>

<div>
    <h2>Overall System Impact</h2>

    <div>
        <h3>CO2 Saved</h3>
        <p>@Model.TotalMetrics.TotalCO2Saved kg</p>
        <p>Carbon dioxide reduction</p>
    </div>

    <div>
        <h3>Water Saved</h3>
        <p>@Model.TotalMetrics.TotalWaterSaved liters</p>
        <p>Water conservation</p>
    </div>

    <div>
        <h3>Landfill Reduced</h3>
        <p>@Model.TotalMetrics.TotalLandfillReduction kg</p>
        <p>Waste diversion from landfills</p>
    </div>

    <div>
        <h3>Items Saved</h3>
        <p>@Model.TotalMetrics.TotalItemsSaved</p>
        <p>Items rescued from disposal</p>
    </div>

    <div>
        <h3>Beneficiaries Supported</h3>
        <p>@Model.TotalMetrics.TotalBeneficiariesSupported</p>
        <p>People helped by donations</p>
    </div>
</div>

