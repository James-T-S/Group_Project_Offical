@page
@model Group_Project_Offical.Pages.Donation_Manager_Incoming_DonationsModel
@{
    ViewData["UserType"] = "donation manager";
}

<div class="container my-5 px-3">
    <h1 class="mb-4" style="font-family: 'Roboto', sans-serif; font-weight: 800;">Incoming Donations</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }

    @if (Model.IncomingDonations == null || Model.IncomingDonations.Count == 0)
    {
        <div class="alert alert-info text-center">No pending donations found for your charity.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped text-center align-middle custom-table">
                <thead style="background-color: #C2A68C;">
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Donor</th>
                        <th>Total Items</th>
                        <th>Est. Value</th>
                        <th>Items</th>
                        <th>Accept</th>
                        <th>Reject</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    @foreach (var d in Model.IncomingDonations)
                    {
                        <tr>
                            <td>@d.DonationID</td>
                            <td>@d.DonationDate.ToString("yyyy-MM-dd")</td>
                            <td>@d.DonerName</td>
                            <td>@d.TotalItems</td>
                            <td>£@d.EstimatedValue.ToString("F2")</td>
                            <td class="text-start">
                                @if (d.Items == null || d.Items.Count == 0)
                                {
                                    <span class="text-muted">No Details</span>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var item in d.Items)
                                        {
                                            <li class="mb-2 border-bottom pb-2">
                                                <strong>@item.ItemName</strong>
                                                <br />
                                                <small class="text-muted">Size: @item.size | @item.Gender | @item.Condition</small>
                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                {
                                                    <br />
                                                    <small class="text-muted fst-italic">"@item.Description"</small>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.PhotoURL))
                                                {
                                                    <div class="mt-1">
                                                        <img src="@item.PhotoURL" alt="Item Photo" class="img-thumbnail" style="max-width:80px; max-height:80px;" />
                                                    </div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Accept">
                                    <input type="hidden" name="donationId" value="@d.DonationID" />
                                    <button type="submit" class="btn btn-success btn-sm">Accept</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Reject" onsubmit="return confirm('Are you sure you want to reject and delete this donation?');">
                                    <input type="hidden" name="donationId" value="@d.DonationID" />
                                    <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>