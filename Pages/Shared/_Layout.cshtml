<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Group_Project_Offical</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Group_Project_Offical.styles.css" asp-append-version="true" />
</head>



<body>
    <header>
        @if (ViewData["HideNav"] as bool? != true)
        {
            @if (ViewData["UserType"] as string == "admin")
            {
                <!--ADMIN-->
                <!--Mobile-->
                <nav class="navbar navbar-expand-lg mobile-nav navbar-light"
                     style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid">
                        <a href="Admin_Dashboard" class="navbar-brand fw-bold"
                           style="color:#374F40;font-size:1.5rem;line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <button class="navbar-toggler" type="button"
                                data-bs-toggle="collapse" data-bs-target="#adminMobileMenu">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="adminMobileMenu">
                            <ul class="navbar-nav ms-auto mt-2">
                                <li class="nav-item border-bottom py-2"><a href="Admin_Manage_Charity" class="nav-link fw-bolder text-black">Manage Charities</a></li>
                                <li class="nav-item border-bottom py-2"><a href="Admin_Manage_Accounts" class="nav-link fw-bolder text-black">Manage Accounts</a></li>
                                <li class="nav-item border-bottom py-2"><a href="Admin_Create_Staff_Accounts" class="nav-link fw-bolder text-black">Create Staff Accounts</a></li>
                                <li class="nav-item border-bottom py-2"><a href="Admin_Generate_Reports" class="nav-link fw-bolder text-black">Generate Report</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <!--Desktop-->
                <nav class="navbar navbar-expand-lg desktop-nav" style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid d-flex justify-content-between">
                        <a href="Admin_Dashboard" class="navbar-brand fw-bold"
                           style="color:#374F40; font-size:1.5rem; line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <ul class="navbar-nav mb-0 me-3 d-flex flex-row">
                            <li class="nav-item ms-3"><a href="Admin_Manage_Charity" class="nav-link fw-bolder text-black">Manage<br />Charities</a></li>
                            <li class="nav-item ms-3"><a href="Admin_Manage_Accounts" class="nav-link fw-bolder text-black">Manage<br />Accounts</a></li>
                            <li class="nav-item ms-3"><a href="Admin_Create_Staff_Accounts" class="nav-link fw-bolder text-black">Create<br />Staff Accounts</a></li>
                            <li class="nav-item ms-3"><a href="Admin_Generate_Reports" class="nav-link fw-bolder text-black">Generate<br />Report</a></li>
                        </ul>
                    </div>
                </nav>
            }
            else if (ViewData["UserType"] as string == "stock manager")
            {
                <!--Stock Manager-->
                <!--Mobile-->
                <nav class="navbar navbar-expand-lg mobile-nav navbar-light"
                     style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid">
                        <a href="Stock_Manager_Dashboard" class="navbar-brand fw-bold"
                           style="color:#374F40;font-size:1.5rem;line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <button class="navbar-toggler" type="button"
                                data-bs-toggle="collapse" data-bs-target="#adminMobileMenu">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="adminMobileMenu">
                            <ul class="navbar-nav ms-auto mt-2">
                                <li class="nav-item border-bottom py-2"><a href="Stock_Manager_Handle_Stock" class="nav-link fw-bolder text-black">Handle <br /> Stock</a></li>
                                <li class="nav-item border-bottom py-2"><a href="Stock_Manager_Recieve_Stock" class="nav-link fw-bolder text-black">Recieve <br /> Stock</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <!--Desktop-->
                <nav class="navbar navbar-expand-lg desktop-nav" style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid d-flex justify-content-between">
                        <a href="Stock_Manager_Dashboard" class="navbar-brand fw-bold"
                           style="color:#374F40; font-size:1.5rem; line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <ul class="navbar-nav mb-0 me-3 d-flex flex-row">
                            <li class="nav-item ms-3"><a href="Stock_Manager_Handle_Stock" class="nav-link fw-bolder text-black">Handle <br /> Stock</a></li>
                            <li class="nav-item ms-3"><a href="Stock_Manager_Recieve_Stock" class="nav-link fw-bolder text-black">Recieve <br /> Stock</a></li>
                        </ul>
                    </div>
                </nav>
            }
            else if (ViewData["UserType"] as string == "donation manager")
            {
                <!--Donation Manager-->
                <!--Mobile-->
                <nav class="navbar navbar-expand-lg mobile-nav navbar-light"
                     style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid">
                        <a href="Donation_Manager_Dashboard" class="navbar-brand fw-bold"
                           style="color:#374F40;font-size:1.5rem;line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <button class="navbar-toggler" type="button"
                                data-bs-toggle="collapse" data-bs-target="#adminMobileMenu">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="adminMobileMenu">
                            <ul class="navbar-nav ms-auto mt-2">
                                <li class="nav-item border-bottom py-2"><a href="Donation_Manager_Incoming_Donations" class="nav-link fw-bolder text-black">Incoming <br /> Donations</a></li>
                                <li class="nav-item border-bottom py-2"><a href="Donation_Manager_Send_Donations" class="nav-link fw-bolder text-black">Send <br /> Donations</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <!--Desktop-->
                <nav class="navbar navbar-expand-lg desktop-nav" style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid d-flex justify-content-between">
                        <a href="Donation_Manager_Dashboard" class="navbar-brand fw-bold"
                           style="color:#374F40; font-size:1.5rem; line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <ul class="navbar-nav mb-0 me-3 d-flex flex-row">
                            <li class="nav-item ms-3"><a href="Donation_Manager_Incoming_Donations" class="nav-link fw-bolder text-black">Incoming <br /> Donations</a></li>
                            <li class="nav-item ms-3"><a href="Donation_Manager_Send_Donations" class="nav-link fw-bolder text-black">Send <br /> Donations</a></li>
                        </ul>
                    </div>
                </nav>
            }
            else if (ViewData["UserType"] as string == "doner")
            {
                <!--Doner-->
                <!--Mobile-->
                <nav class="navbar navbar-expand-lg mobile-nav navbar-light"
                     style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid">
                        <a href="Doner_Dashboard" class="navbar-brand fw-bold"
                           style="color:#374F40;font-size:1.5rem;line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <button class="navbar-toggler" type="button"
                                data-bs-toggle="collapse" data-bs-target="#adminMobileMenu">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="adminMobileMenu">
                            <ul class="navbar-nav ms-auto mt-2">
                                <li class="nav-item border-bottom py-2"><a href="Doner_Donate" class="nav-link fw-bolder text-black">Donate</a></li>
                                <li class="nav-item border-bottom py-2"><a href="Doner_Donation_History" class="nav-link fw-bolder text-black">Donation <br /> History</a></li>
                                <li class="nav-item border-bottom py-2"><a href="Doner_Delete_Account" class="nav-link fw-bolder text-black">Manage <br /> Account</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <!--Desktop-->
                <nav class="navbar navbar-expand-lg desktop-nav" style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid d-flex justify-content-between">
                        <a href="Doner_Dashboard" class="navbar-brand fw-bold"
                           style="color:#374F40; font-size:1.5rem; line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <ul class="navbar-nav mb-0 me-3 d-flex flex-row">
                            <li class="nav-item ms-3"><a href="Doner_Donate" class="btn fw-bolder text-black">Donate</a></li>
                            <li class="nav-item ms-3"><a href="Doner_Donation_History" class="nav-link fw-bolder text-black">Donation <br /> History</a></li>
                            <li class="nav-item ms-3"><a href="Doner_Delete_Account" class="nav-link fw-bolder text-black">Manage <br /> Account</a></li>
                        </ul>
                    </div>
                </nav>
            }
            else
            {
                <!--Guest-->
                <!--Mobile-->
                <nav class="navbar navbar-expand-lg mobile-nav navbar-light"
                     style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid">
                        <a href="Index" class="navbar-brand fw-bold"
                           style="color:#374F40;font-size:1.5rem;line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <button class="navbar-toggler" type="button"
                                data-bs-toggle="collapse" data-bs-target="#adminMobileMenu">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="adminMobileMenu">
                            <ul class="navbar-nav ms-auto mt-2">
                                <li class="nav-item border-bottom py-2"><a href="UniversalLogin" class="nav-link fw-bolder text-black">Donate</a></li>
                                <li class="nav-item border-bottom py-2"><a href="UniversalLogin" class="nav-link fw-bolder text-black">Login</a></li>
                                <li class="nav-item border-bottom py-2"><a href="SignUp" class="nav-link fw-bolder text-black">Sign Up</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <!--Desktop-->
                <nav class="navbar navbar-expand-lg desktop-nav" style="background-color:#C2A68C; padding:0.5vh; margin:0;">
                    <div class="container-fluid d-flex justify-content-between">
                        <a href="Index" class="navbar-brand fw-bold"
                           style="color:#374F40; font-size:1.5rem; line-height:1;">
                            Sustain <br /> Wear
                        </a>

                        <ul class="navbar-nav mb-0 me-3 d-flex flex-row">
                            <li class="nav-item ms-3"><a href="UniversalLogin" class="btn fw-bolder text-black">Donate</a></li>
                            <li class="nav-item ms-3"><a href="UniversalLogin" class="nav-link fw-bolder text-black">Login</a></li>
                            <li class="nav-item ms-3"><a href="SignUp" class="nav-link fw-bolder text-black">Sign Up</a></li>
                        </ul>
                    </div>
                </nav>
            }
        }
    </header>


    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-secondary w-100 mt-auto">
        <div class="text-white ps-5 py-2">
            &copy; 2025 - SustainWear - <a asp-area="" asp-page="/Privacy" class="text-white text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>