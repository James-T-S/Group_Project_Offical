<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Group_Project_Offical</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Group_Project_Offical.styles.css" asp-append-version="true" />
</head>



<body>
    <header>
        @if (ViewData["HideNav"] as bool? != true)
        {
            <!--ADMIN-->
            <!--Mobile-->
            <nav id="adminMobileNav" class="navbar navbar-expand-lg"
                 style="background-color:#C2A68C;padding:0.5vh;margin:0;display:none;">
                <div class="container-fluid">
                    <a href="Admin_Dashboard" class="navbar-brand fw-bold"
                       style="color:#374F40;font-size:1.5rem;line-height:1;">
                        Sustain <br /> Wear
                    </a>

                    <button class="navbar-toggler" type="button"
                            data-bs-toggle="collapse" data-bs-target="#adminMobileMenu">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="adminMobileMenu">
                        <ul class="navbar-nav ms-auto mt-2">
                            <li class="nav-item border-bottom py-2"><a href="Admin_Manage_Charity" class="nav-link">Manage Charities</a></li>
                            <li class="nav-item border-bottom py-2"><a href="Admin_Manage_Accounts" class="nav-link">Manage Accounts</a></li>
                            <li class="nav-item border-bottom py-2"><a href="Admin_Create_Staff_Accounts" class="nav-link">Create Staff Accounts</a></li>
                            <li class="nav-item border-bottom py-2"><a href="Admin_Generate_Reports" class="nav-link">Generate Report</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!--Desktop-->
            <nav id="adminDesktopNav" class="navbar navbar-expand-lg" style="background-color:#C2A68C;padding:0.5vh;margin:0;">
                <div class="container-fluid d-flex justify-content-between">
                    <a href="Admin_Dashboard" class="navbar-brand fw-bold"
                       style="color:#374F40;font-size:1.5rem;line-height:1;">
                        Sustain <br /> Wear
                    </a>

                    <ul class="navbar-nav mb-0 me-3 d-flex flex-row">
                        <li class="nav-item ms-3"><a href="Admin_Manage_Charity" class="nav-link fw-bolder text-black">Manage<br />Charities</a></li>
                        <li class="nav-item ms-3"><a href="Admin_Manage_Accounts" class="nav-link fw-bolder text-black">Manage<br />Accounts</a></li>
                        <li class="nav-item ms-3"><a href="Admin_Create_Staff_Accounts" class="nav-link fw-bolder text-black">Create<br />Staff Accounts</a></li>
                        <li class="nav-item ms-3"><a href="Admin_Generate_Reports" class="nav-link fw-bolder text-black">Generate<br />Report</a></li>
                    </ul>
                </div>
            </nav>
        }


        <!--Admin-->
        <nav class="navbar navbar-expand-lg" style="background-color: #C2A68C; padding: 0.5vh; margin: 0;">
            <div class="container-fluid">

                <a href="Admin_Dashboard" class="navbar-brand fw-bold"
                   style="color: #374F40; font-size: 1.5rem; text-decoration: none; line-height: 1;">
                    Sustain <br /> Wear
                </a>

                <button class="navbar-toggler d-lg-none d-block" type="button"
                        data-bs-toggle="collapse" data-bs-target="#adminMenu"
                        aria-controls="adminMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <ul class="navbar-nav mb-0 ms-auto d-none d-lg-flex flex-row">
                    <li class="nav-item d-flex align-items-center ms-3">
                        <a class="nav-link fw-bolder text-black" href="Admin_Manage_Charity">Manage <br> Charities</a>
                    </li>
                    <li class="nav-item d-flex align-items-center ms-3">
                        <a class="nav-link fw-bolder text-black" href="Admin_Manage_Accounts">Manage <br> Accounts</a>
                    </li>
                    <li class="nav-item d-flex align-items-center ms-3">
                        <a class="nav-link fw-bolder text-black" href="Admin_Create_Staff_Accounts">Create <br> Staff Accounts</a>
                    </li>
                    <li class="nav-item d-flex align-items-center ms-3">
                        <a class="nav-link fw-bolder text-black" href="Admin_Generate_Reports">Generate <br> Report</a>
                    </li>
                </ul>

                <div class="collapse navbar-collapse d-lg-none" id="adminMenu">
                    <ul class="navbar-nav mt-2">
                        <li class="nav-item border-bottom py-2">
                            <a href="Admin_Manage_Charity" class="nav-link fw-bolder text-black">Manage Charities</a>
                        </li>
                        <li class="nav-item border-bottom py-2">
                            <a href="Admin_Manage_Accounts" class="nav-link fw-bolder text-black">Manage Accounts</a>
                        </li>
                        <li class="nav-item border-bottom py-2">
                            <a href="Admin_Create_Staff_Accounts" class="nav-link fw-bolder text-black">Create Staff Accounts</a>
                        </li>
                        <li class="nav-item border-bottom py-2">
                            <a href="Admin_Generate_Reports" class="nav-link fw-bolder text-black">Generate Report</a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>

        <!--Stock Manager-->
        <nav class="navbar navbar-expand-lg" style="background-color: #C2A68C; padding: 0.5vh; margin: 0;">
            <div class="container-fluid d-flex justify-content-between">
                <a href="Stock_Manager_Dashboard" class="navbar-brand fw-bold" style="color: #374F40; font-size: 1.5rem; text-decoration: none; line-height: 1;">
                    Sustain <br /> Wear
                </a>

                <ul class="navbar-nav mb-0 me-3 d-flex flex-row">
                    <li class="nav-item d-flex justify-content-center align-items-center" style="line-height: 1">
                        <a href="Admin_Manage_Charity" class="nav-link active fw-bolder text-black">Manage <br /> Charities</a>
                    </li>
                    <li class="nav-item d-flex justify-content-center align-items-center ms-3" style="line-height: 1">
                        <a class="nav-link active fw-bolder text-black" aria-current="page" href="Admin_Manage_Accounts">Manage <br /> Accounts</a>
                    </li>
                    <li class="nav-item d-flex justify-content-center align-items-center ms-3" style="line-height: 1">
                        <a class="nav-link fw-bolder text-black" href="Admin_Create_Staff_Accounts">Create <br /> Staff Accounts</a>
                    </li>
                    <li class="nav-item d-flex justify-content-center align-items-center ms-3" style="line-height: 1">
                        <a class="nav-link fw-bolder text-black" href="Admin_Generate_Reports">Generate <br /> Report</a>
                    </li>
                </ul>
            </div>
        </nav>


        @if (ViewData["HideNav"] as bool? != true)
        {
            <nav class="navbar navbar-expand-lg" style="background-color: #C2A68C; padding: 0.5vh; margin: 0;">
                <div class="container-fluid d-flex justify-content-between">
                    <a href="Index" class="navbar-brand fw-bold" style="color: #374F40; font-size: 1.5rem; text-decoration: none; line-height: 1;">
                        Sustain <br /> Wear
                    </a>

                    <ul class="navbar-nav mb-0 me-3 d-flex flex-row">
                        <li class="nav-item d-flex justify-content-center align-items-center">
                            <a href="UniversalLogin" class="btn nav-donate-btn fw-semibold text-black">Donate</a>
                        </li>
                        <li class="nav-item d-flex justify-content-center align-items-center ms-3">
                            <a class="nav-link active fw-bolder text-black" aria-current="page" href="UniversalLogin">Login</a>
                        </li>
                        <li class="nav-item d-flex justify-content-center align-items-center ms-3">
                            <a class="nav-link fw-bolder text-black" href="SignUp">Signup</a>
                        </li>
                    </ul>
                </div>
            </nav>
        }
    </header>

    <script>
        const isMobile = window.innerWidth < 600;

        const adminMobile = document.getElementById("adminMobileNav");
        const adminDesktop = document.getElementById("adminDesktopNav");

        if (adminMobile && adminDesktop) {
            if (isMobile) {
                adminMobile.style.display = "block";
                adminDesktop.style.display = "none";
            } else {
                adminMobile.style.display = "none";
                adminDesktop.style.display = "block";
            }
        }
    </script>


    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-secondary w-100 mt-auto">
        <div class="text-white ps-5 py-2">
            &copy; 2025 - SustainWear - <a asp-area="" asp-page="/Privacy" class="text-white text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>