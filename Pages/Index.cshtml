@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!doctype html>
<html lang="en">
<head>
    <title>SustainWear</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body>

    <div class="hero-container">
        <img src="images/HomelessMan.webp" alt="mans homeless" class="hero-shot" />
        <a href="UniversalLogin" class="donate-btn">Donate</a>
    </div>

    <div class="max-width">
        <div class="text-image">
            <div class="index-text">
                <h1>Sustaining People. Sustaining the Planet.</h1>
                <p>
                    At Sustain Wear, we believe no good garment should go to waste — and no one should go without.
                    We collect, sort, and distribute quality clothing donations to trusted charities that serve
                    communities in need. Every shirt, jacket, and pair of shoes we handle is another step toward a
                    more sustainable and compassionate world, where the cycle of waste is replaced by a circle of
                    care.
                </p>
            </div>
            <img src="images\PeopleGivingOutClothes.jpeg" alt="Alternate Text" />
        </div>

        <div class="index-sustainability">
            <div>
                <img src="images\PeopleGivingOutClothes.jpeg" alt="Alternate Text" />
                <h1>C02 saved: <br /> 200KG</h1>
            </div>

            <div>
                <img src="images\PeopleGivingOutClothes.jpeg" alt="Alternate Text" />
                <h1>Water saved: <br /> 200 Litres</h1>
            </div>

            <div>
                <img src="images\PeopleGivingOutClothes.jpeg" alt="Alternate Text" />
                <h1>Landfill saved: <br /> 200KG</h1>
            </div>
        </div>

        <div class="text-image">
            <img src="images\TreeSaplingGrowing.jpg" alt="Alternate Text" />
            <div class="index-text">
                <h1>Making Sustainable Giving Simple.</h1>
                <p>
                    Fashion shouldn’t cost the earth, and helping others shouldn’t be complicated. Sustain Wear
                    connects surplus clothing with the people and charities that need it most, reducing textile
                    waste while supporting dignity and comfort for all. By streamlining donation and distribution,
                    we make it easy for individuals and brands to do good — responsibly.
                </p>
            </div>
        </div>

        <div class="text-image">
            <div class="index-text">
                <h1>Every Garment Deserves a Second Story.</h1>
                <p>
                    What we wear tells a story — and at Sustain Wear, we’re helping those stories continue. Through
                    partnerships with local charities, shelters, and aid groups, we ensure that gently used clothes
                    find their way to new owners who truly need them. Together, we’re building a future where
                    sustainability meets generosity, one garment at a time.
                </p>
            </div>
            <img src="images\HomelessMan.webp " alt="Alternate Text" />
        </div>
    </div>

</body>
</html>