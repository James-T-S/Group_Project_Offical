@page
@model Group_Project_Offical.Pages.Stock_Manager_DashboardModel
@{
    Layout = "_Layout";
    ViewData["UserType"] = "stock manager";
}

<div class="d-flex" style="min-height:100vh;">

    <div style="width:250px; background-color:#C2A68C;" class="d-flex flex-column pt-4">
        <a href="Stock_Manager_Handle_Stock" class="text-decoration-none text-black py-3 px-4 d-block">Handle Stock</a>

        <a href="Doner_Delete_Account" class="text-decoration-none text-black py-3 px-4 d-block mt-auto">Manage Account</a>
    </div>

    <div class="flex-grow-1 p-4">

        <h1 class="mb-4 text-center">Stock Manager Dashboard</h1>

        <div class="row mb-5">
            <div class="col-12">
                <h3 class="mb-3 text-center">Overall Sustainability Metrics</h3>

                <div class="row">

                    <div class="col-md-3 col-6 mb-3">
                        <div class="card text-center bg-success text-white big-card">
                            <div class="card-body">
                                <h4>@Model.TotalMetrics.TotalCO2Saved.ToString("F1") kg</h4>
                                <p>CO₂ Saved</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-6 mb-3">
                        <div class="card text-center bg-info text-white big-card">
                            <div class="card-body">
                                <h4>@Model.TotalMetrics.TotalWaterSaved.ToString("F0") L</h4>
                                <p>Water Saved</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-6 mb-3">
                        <div class="card text-center bg-warning text-dark big-card">
                            <div class="card-body">
                                <h4>@Model.TotalMetrics.TotalLandfillReduction.ToString("F1") kg</h4>
                                <p>Landfill Reduced</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-6 mb-3">
                        <div class="card text-center bg-primary text-white big-card">
                            <div class="card-body">
                                <h4>@Model.TotalMetrics.TotalItemsSaved</h4>
                                <p>Items Saved</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-6 mb-3">
                        <div class="card text-center bg-secondary text-white big-card">
                            <div class="card-body">
                                <h4>@Model.TotalMetrics.TotalBeneficiariesSupported</h4>
                                <p>People Helped</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
