@page
@model Group_Project_Offical.Pages.Stock_Manager_Handle_StockModel

<!DOCTYPE html>
<html>
<head>
</head>
<body>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            @if (Model.Id != null)
            {
                            <text>
                                new bootstrap.Modal(document.getElementById('donationModal')).show();
                            </text>
            }

            const sel = document.getElementById("ItemSelect");
            if (!sel) return;

            sel.addEventListener("change", function () {
                let opt = this.selectedOptions[0];
                if (!opt) return;

                document.getElementById("ItemName").value = opt.dataset.name;
                document.getElementById("ItemDesc").value = opt.dataset.desc;
                document.getElementById("ItemSize").value = opt.dataset.size;

                let categoryName = opt.dataset.category;
                let categorySelect = document.getElementById("ItemCategory");

                for (let option of categorySelect.options) {
                    option.selected = (option.text === categoryName);
                }
            });

            if (sel.selectedIndex >= 0)
                sel.dispatchEvent(new Event("change"));
        });
    </script>






    <div class="container">
        <table class="table table-bordered table-striped text-center centred-items">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Value</th>
                    <th>Items</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var donation in Model.Donations)
                {
                    <tr>
                        <td>@donation.DonationID</td>
                        <td>@donation.DonationDate</td>
                        <td>@donation.StatusName</td>
                        <td>@donation.EstimatedValue</td>
                        <td>
                            @foreach (var item in donation.Items)
                            {
                                <div>@item.ItemName</div>
                            }
                        </td>
                        <td>
                            <a href="?id=@donation.DonationID" class="btn">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <div class="modal fade" id="donationModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Edit Donation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form method="post" asp-page-handler="Update">
                    <div class="modal-body d-flex flex-column gap-4">

                        <input type="hidden" name="Id" id="DonationID" />

                        <select id="ItemSelect" name="DonationItemID" class="form-select">
                            @if (Model.SelectedDonation != null)
                            {
                                foreach (var item in Model.SelectedDonation.Items)
                                {
                                    <option value="@item.DonationItemID"
                                            data-name="@item.ItemName"
                                            data-desc="@item.Description"
                                            data-size="@item.Size"
                                            data-category="@item.CategoryName">
                                        @item.ItemName
                                    </option>
                                }
                            }
                            else
                            {
                                <option disabled>No Items</option>
                            }
                        </select>

                        <input id="ItemName" name="UpdatedItemName" class="form-control" placeholder="Name" />
                        <input id="ItemDesc" name="UpdatedItemDesc" class="form-control" placeholder="Description" />
                        <input id="ItemSize" name="UpdatedItemSize" class="form-control" placeholder="Size" />

                        <select id="ItemCategory" name="UpdatedItemCategory" class="form-control">
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Value">@category.Value</option>
                            }
                        </select>

                        <select name="UpdateStatusName" class="form-control">
                            <option value="Pending">Pending</option>
                            <option value="Processing">Processing</option>
                            <option value="Completed">Completed</option>
                        </select>

                        <input type="number" name="UpdateEstimatedValue" class="form-control" placeholder="Estimated Value" />

                        <button type="submit" class="btn btn-primary mx-auto">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
